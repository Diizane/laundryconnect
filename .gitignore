# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
dist/
build/

# Environment / secrets — never commit real credentials
.env
.env.*
!.env.example

# Provider session state — authenticated browser storage; never commit.
# (The loader also refuses any session path inside the repo, defence in depth.)
*-session.json
*session-state*.json
.laundryconnect/

# Node / React (admin portal, future)
node_modules/
apps/admin/dist/

# Flutter / Dart (mobile, future)
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins*

# Local databases (SQLite dev/test files)
*.db

# Claude Code local settings
.claude/settings.local.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Key material (from original scaffold ignore rules)
*.pem
*.key
