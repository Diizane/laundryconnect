# LaundryConnect API configuration
# Copy to .env for local development. NEVER commit a real .env file.
# All values here are placeholders — see docs/SECURITY.md.

# development | test | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL connection (used from Milestone 4 onwards; optional until then).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Comma-separated allowed CORS origins (e.g. the admin portal dev server).
CORS_ORIGINS=

# Provider connectors to enable. "mock" is sample data; "alliance" defaults
# to fixture mode (recorded/synthetic data, no live requests).
ENABLED_PROVIDERS=mock

# Per-provider search timeout in seconds.
PROVIDER_TIMEOUT_SECONDS=10

# --- Alliance connector -------------------------------------------------------
# Mode: fixture (default, no network, CI-safe) | session | credential.
ALLIANCE_MODE=fixture
# Path to the operator's authenticated browser session — set for session mode.
# MUST be OUTSIDE the repository; never committed; never logged. Create it with
# `python -m app.providers.alliance.bootstrap` (manual login).
# ALLIANCE_SESSION_PATH=/Users/you/.laundryconnect/alliance-session.json
# Mirrors docs/PROVIDER_ACCESS/alliance-laundry-systems.md. Live modes refuse
# to run until this is true. Access is currently UNKNOWN — leave false.
ALLIANCE_ACCESS_APPROVED=false

# Provider credentials are NEVER read from here or from files. If/when the
# provider terms permit automated login, credentials come only from the
# deployment environment or a secret manager — never committed, never logged.
